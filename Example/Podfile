# 由 Demo 导出脚本填入已发布版本后生成 Podfile。
source 'https://github.com/CocoaPods/Specs.git'
source 'https://github.com/tigerfintech/Specs.git'

# 沿用当前 Example target 的最低系统版本。
platform :ios, '15.0'
use_frameworks! :linkage => :dynamic

project 'TigerQuoteSDK.xcodeproj'

target 'TigerQuoteSDK_Example' do
  pod 'TigerTradingSDK', '3.2.2'
end

target 'TigerQuoteSDK_Example_US' do
  pod 'TigerTradingSDKUS', '3.2.2'
end

# 只调整本 Demo 生成的 Pods 工程，与当前 Example 的最低系统版本一致。
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |configuration|
      configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
